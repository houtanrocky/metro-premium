{
  "name": "metropremium",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web -- --host 127.0.0.1",
    "build": "node scripts/sync-public.mjs && npm run build --workspace apps/web",
    "typecheck": "npm run typecheck --workspace apps/web",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:docs": "node scripts/check-docs.mjs",
    "pipeline:smoke": "node scripts/task.mjs smoke",
    "reproduce": "node scripts/task.mjs reproduce --offline"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.9.1",
    "jsdom": "^27.0.1",
    "vitest": "^5.0.5"
  }
}
